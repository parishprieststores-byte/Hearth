rules_version = '2';
// Hearth 2.0 P0 rules. NOT executed against the Firestore emulator (none available in the build environment).
service cloud.firestore { match /databases/{d}/documents {
  function signedIn(){ return request.auth != null; }
  function isMember(c){ return signedIn() && request.auth.uid in get(/databases/$(d)/documents/chats/$(c)).data.members; }
  // true when a per-user map changed only under the caller's own uid
  function ownKeyOnly(a, b){ return a.diff(b).affectedKeys().hasOnly([request.auth.uid]); }
  // true when a list gained or lost nothing except the caller's uid
  function ownItemOnly(a, b){ return a.toSet().difference(b.toSet()).hasOnly([request.auth.uid]) && b.toSet().difference(a.toSet()).hasOnly([request.auth.uid]); }

  match /users/{u} {
    allow read: if signedIn();
    allow create, update: if request.auth.uid == u
      && request.resource.data.keys().hasOnly(['name','nameLower','email','photo','about','bmd','updates','updAt','lastSeen'])
      && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 160
      && (!('about' in request.resource.data) || (request.resource.data.about is string && request.resource.data.about.size() <= 300))
      && (!('updates' in request.resource.data) || (request.resource.data.updates is list && request.resource.data.updates.size() <= 6));
    allow delete: if request.auth.uid == u;
  }

  // voice-call signalling (only people who already share a chat can ring each other)
  match /calls/{id} {
    allow read: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    allow create: if signedIn() && request.resource.data.from == request.auth.uid && request.resource.data.to != request.auth.uid
      && request.resource.data.keys().hasOnly(['from','to','chat','state','offer','at'])
      && request.resource.data.state == 'ringing' && request.resource.data.at == request.time
      && request.resource.data.offer.sdp.size() <= 20000
      && request.auth.uid in get(/databases/$(d)/documents/chats/$(request.resource.data.chat)).data.members
      && request.resource.data.to in get(/databases/$(d)/documents/chats/$(request.resource.data.chat)).data.members;
    allow update: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid)
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state','answer','endedAt'])
      && request.resource.data.state in ['ringing','active','ended','declined','missed'];
    match /ice/{i} {
      allow read: if signedIn() && (get(/databases/$(d)/documents/calls/$(id)).data.to == request.auth.uid || get(/databases/$(d)/documents/calls/$(id)).data.from == request.auth.uid);
      allow create: if signedIn() && request.resource.data.from == request.auth.uid && request.resource.data.keys().hasOnly(['from','c']) && request.resource.data.c.size() <= 2000
        && (get(/databases/$(d)/documents/calls/$(id)).data.to == request.auth.uid || get(/databases/$(d)/documents/calls/$(id)).data.from == request.auth.uid);
    }
  }

  // ---------- Communities ----------
  function mdoc(cid, u){ return /databases/$(d)/documents/communities/$(cid)/members/$(u); }
  function cdoc(cid){ return get(/databases/$(d)/documents/communities/$(cid)).data; }
  function isActive(cid){ return signedIn() && exists(mdoc(cid, request.auth.uid)) && get(mdoc(cid, request.auth.uid)).data.status == 'active'; }
  function myRole(cid){ return get(mdoc(cid, request.auth.uid)).data.role; }
  function isStaff(cid){ return isActive(cid) && myRole(cid) in ['owner','admin']; }
  function isLeader(cid){ return isActive(cid) && myRole(cid) in ['owner','admin','leader']; }
  function spaceOf(cid, sid){ return get(/databases/$(d)/documents/communities/$(cid)/spaces/$(sid)).data; }

  match /users/{u}/mycomm/{c} {
    allow read, delete: if signedIn() && request.auth.uid == u;
    allow create, update: if signedIn() && request.auth.uid == u
      && request.resource.data.keys().hasOnly(['name','at'])
      && request.resource.data.name is string && request.resource.data.name.size() <= 60;
  }

  match /discover/{cid} {
    allow read: if signedIn();
    allow create, update: if signedIn() && cdoc(cid).owner == request.auth.uid && cdoc(cid).kind == 'public'
      && request.resource.data.keys().hasOnly(['name','nameLower','desc'])
      && request.resource.data.name is string && request.resource.data.name.size() <= 60
      && request.resource.data.desc is string && request.resource.data.desc.size() <= 400;
    allow delete: if signedIn() && cdoc(cid).owner == request.auth.uid;
  }

  match /communities/{cid} {
    allow read: if signedIn();
    allow create: if signedIn() && request.resource.data.owner == request.auth.uid
      && request.resource.data.keys().hasOnly(['name','nameLower','desc','kind','approval','owner','at'])
      && request.resource.data.kind in ['public','private'] && request.resource.data.approval is bool
      && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
      && request.resource.data.desc is string && request.resource.data.desc.size() <= 400
      && request.resource.data.at == request.time;
    allow update: if ( isStaff(cid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','nameLower','desc','approval'])
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60 )
      || ( isActive(cid) && myRole(cid) == 'owner'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owner'])
        && request.resource.data.owner != request.auth.uid
        && get(mdoc(cid, request.resource.data.owner)).data.role == 'admin'
        && get(mdoc(cid, request.resource.data.owner)).data.status == 'active' );
    allow delete: if isActive(cid) && myRole(cid) == 'owner';

    match /private/{x} {
      allow read, write: if isStaff(cid);
    }

    match /members/{u} {
      allow read: if signedIn() && (request.auth.uid == u || isActive(cid));
      allow create: if signedIn() && request.auth.uid == u && request.resource.data.uid == u
        && request.resource.data.keys().hasOnly(['uid','name','role','status','at','code'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.at == request.time
        && (
          ( request.resource.data.role == 'owner' && request.resource.data.status == 'active'
            && cdoc(cid).owner == u && !('code' in request.resource.data) )
          || ( request.resource.data.role == 'member'
            && request.resource.data.status == (cdoc(cid).approval ? 'pending' : 'active')
            && ( cdoc(cid).kind == 'public'
                 || request.resource.data.get('code', '') == get(/databases/$(d)/documents/communities/$(cid)/private/invite).data.code ) )
        );
      allow update: if ( isStaff(cid) && u != cdoc(cid).owner
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','status'])
          && request.resource.data.role in ['member','leader','admin']
          && request.resource.data.status in ['active','suspended']
          && (request.resource.data.role != 'admin' || myRole(cid) == 'owner')
          && (resource.data.role != 'admin' || myRole(cid) == 'owner') )
        // ownership transfer (done in one batch with the community owner change)
        || ( isActive(cid) && myRole(cid) == 'owner' && resource.data.role == 'admin'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role == 'owner'
          && getAfter(/databases/$(d)/documents/communities/$(cid)).data.owner == u )
        || ( request.auth.uid == u && resource.data.role == 'owner'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role == 'admin'
          && getAfter(/databases/$(d)/documents/communities/$(cid)).data.owner != u );
      allow delete: if signedIn() && (
          ( resource.data.role != 'owner' && (
              (request.auth.uid == u && resource.data.status != 'suspended')
              || (isStaff(cid) && (resource.data.role != 'admin' || myRole(cid) == 'owner')) ) )
          || ( resource.data.role == 'owner' && request.auth.uid == u && !exists(/databases/$(d)/documents/communities/$(cid)) )
        );
    }

    match /spaces/{sid} {
      allow read: if isActive(cid) && (resource.data.lead == false || isLeader(cid));
      allow create: if isStaff(cid)
        && request.resource.data.keys().hasOnly(['name','kind','lead','ord','at'])
        && request.resource.data.kind in ['chat','announce','prayer','events','leaders']
        && request.resource.data.lead == (request.resource.data.kind == 'leaders')
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.at == request.time;
      allow update: if isStaff(cid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','ord']);
      allow delete: if isStaff(cid);

      match /posts/{p} {
        allow read: if isActive(cid) && (spaceOf(cid, sid).lead == false || isLeader(cid));
        allow create: if isActive(cid) && request.resource.data.from == request.auth.uid
          && request.resource.data.keys().hasOnly(['from','name','text','img','at','poll'])
          && (!('poll' in request.resource.data) || (request.resource.data.poll is map && request.resource.data.poll.keys().hasOnly(['q','opts'])
              && request.resource.data.poll.q is string && request.resource.data.poll.q.size() > 0 && request.resource.data.poll.q.size() <= 200
              && request.resource.data.poll.opts is list && request.resource.data.poll.opts.size() >= 2 && request.resource.data.poll.opts.size() <= 6))
          && request.resource.data.at == request.time
          && request.resource.data.name is string && request.resource.data.name.size() <= 60
          && request.resource.data.text is string && request.resource.data.text.size() <= 2000
          && ( spaceOf(cid, sid).kind in ['chat','prayer'] || isLeader(cid) )
          && ( spaceOf(cid, sid).kind != 'events' )
          && ( spaceOf(cid, sid).lead == false || isLeader(cid) );
        allow update: if isActive(cid) && (
          ( request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            && ownKeyOnly(request.resource.data.get('reactions', {}), resource.data.get('reactions', {})) )
          || ( 'poll' in resource.data
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
            && ownKeyOnly(request.resource.data.get('votes', {}), resource.data.get('votes', {}))
            && (!(request.auth.uid in request.resource.data.votes) || (request.resource.data.votes[request.auth.uid] is int
                && request.resource.data.votes[request.auth.uid] >= 0 && request.resource.data.votes[request.auth.uid] < resource.data.poll.opts.size())) )
          || ( resource.data.from == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','edited'])
            && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000 )
          || ( isLeader(cid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned']) && request.resource.data.pinned is bool ) );
        allow delete: if isActive(cid) && (resource.data.from == request.auth.uid || isStaff(cid));
      }

      match /events/{e} {
        allow read: if isActive(cid);
        allow create: if isLeader(cid) && spaceOf(cid, sid).kind == 'events'
          && request.resource.data.keys().hasOnly(['title','when','place','note','by','at','rsvp'])
          && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time
          && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
          && request.resource.data.when is int
          && request.resource.data.place is string && request.resource.data.place.size() <= 80
          && request.resource.data.note is string && request.resource.data.note.size() <= 400
          && request.resource.data.rsvp == {};
        allow update: if isActive(cid) && (
          ( request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvp'])
            && ownKeyOnly(request.resource.data.rsvp, resource.data.rsvp)
            && (!(request.auth.uid in request.resource.data.rsvp) || request.resource.data.rsvp[request.auth.uid] in ['yes','no','maybe']) )
          || ( isLeader(cid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','when','place','note']) ) );
        allow delete: if isLeader(cid);
      }
    }
  }

  match /chats/{c} {
    allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.members);

    allow create: if signedIn() && request.auth.uid in request.resource.data.members
      && request.resource.data.members.size() <= 256
      && (
        // saved messages
        (request.resource.data.members.size() == 1 && c == request.auth.uid + '_self')
        // direct chat: id is the two sorted uids
        || (request.resource.data.members.size() == 2 && request.resource.data.isGroup == false
            && c == request.resource.data.members[0] + '_' + request.resource.data.members[1])
        // group: the creator becomes the only admin
        || (request.resource.data.members.size() >= 3 && request.resource.data.isGroup == true
            && request.resource.data.admins == [request.auth.uid])
      );

    allow update: if signedIn() && request.auth.uid in resource.data.members && (
      // 1. ordinary member activity: members and admins cannot change, per-user maps only under own uid
      ( request.resource.data.members == resource.data.members
        && request.resource.data.get('admins', []) == resource.data.get('admins', [])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastFrom','lastText','lastAt','unread','typing','delivered','arch','folder','mute','pin','names','pinned','title','photo'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['title','photo'])
            || resource.data.isGroup == true && request.auth.uid in resource.data.get('admins', resource.data.members))
        && (!('lastFrom' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.lastFrom == request.auth.uid)
        && ownKeyOnly(request.resource.data.get('typing', {}), resource.data.get('typing', {}))
        && ownKeyOnly(request.resource.data.get('delivered', {}), resource.data.get('delivered', {}))
        && ownKeyOnly(request.resource.data.get('arch', {}), resource.data.get('arch', {}))
        && ownKeyOnly(request.resource.data.get('folder', {}), resource.data.get('folder', {}))
        && ownKeyOnly(request.resource.data.get('mute', {}), resource.data.get('mute', {}))
        && ownKeyOnly(request.resource.data.get('pin', {}), resource.data.get('pin', {}))
        && ownKeyOnly(request.resource.data.get('names', {}), resource.data.get('names', {}))
      )
      // 2. group admins manage membership (legacy groups without an admins list: every member is an admin)
      || ( resource.data.isGroup == true
        && request.auth.uid in resource.data.get('admins', resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','admins','names','unread','typing','delivered'])
        && request.resource.data.members.size() >= 2 && request.resource.data.members.size() <= 256
        && request.resource.data.get('admins', []).toSet().difference(request.resource.data.members.toSet()).size() == 0
        && request.auth.uid in request.resource.data.members )
      // 3. any member may leave a group (removing only themselves)
      || ( resource.data.isGroup == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','admins'])
        && ownItemOnly(request.resource.data.members, resource.data.members)
        && !(request.auth.uid in request.resource.data.members)
        && request.resource.data.get('admins', []).toSet().difference(request.resource.data.members.toSet()).size() == 0 )
    );

    // file chunks (base64 pieces of documents; free plan has no Storage)
    allow delete: if signedIn() && resource.data.isGroup == true && request.auth.uid in resource.data.get('admins', []);

    match /chunks/{k} {
      allow read: if isMember(c);
      allow create: if isMember(c) && request.resource.data.from == request.auth.uid
        && request.resource.data.keys().hasOnly(['fid','n','d','from','at'])
        && request.resource.data.n is int && request.resource.data.n >= 0 && request.resource.data.n < 10
        && k == request.resource.data.fid + '_' + string(request.resource.data.n)
        && request.resource.data.d is string && request.resource.data.d.size() <= 720000
        && request.resource.data.at == request.time;
      allow delete: if isMember(c) && (resource.data.from == request.auth.uid
        || (get(/databases/$(d)/documents/chats/$(c)).data.isGroup == true && request.auth.uid in get(/databases/$(d)/documents/chats/$(c)).data.get('admins', [])));
    }

    match /messages/{m} {
      allow read: if isMember(c);
      allow delete: if isMember(c) && get(/databases/$(d)/documents/chats/$(c)).data.isGroup == true
        && request.auth.uid in get(/databases/$(d)/documents/chats/$(c)).data.get('admins', []);
      allow create: if isMember(c) && request.resource.data.from == request.auth.uid
        && request.resource.data.keys().hasOnly(['from','text','img','audio','reply','fwd','at','readBy','file','st','gif','call'])
        && (!('st' in request.resource.data) || request.resource.data.st is bool)
        && (!('gif' in request.resource.data) || (request.resource.data.gif is string && request.resource.data.gif.size() <= 300 && request.resource.data.gif.matches('https://media[0-9]*\\.giphy\\.com/.*')))
        && (!('call' in request.resource.data) || (request.resource.data.call is map && request.resource.data.call.keys().hasOnly(['r','d'])
            && request.resource.data.call['r'] in ['ended','missed','cancelled','declined'] && request.resource.data.call['d'] is int
            && request.resource.data.call['d'] >= 0 && request.resource.data.call['d'] <= 86400))
        && (!('file' in request.resource.data) || (request.resource.data.file is map && request.resource.data.file.keys().hasOnly(['id','name','size','type','n'])
            && request.resource.data.file['n'] is int && request.resource.data.file['n'] >= 1 && request.resource.data.file['n'] <= 10
            && request.resource.data.file['size'] is int && request.resource.data.file['size'] <= 5000000
            && request.resource.data.file['name'] is string && request.resource.data.file['name'].size() <= 120))
        && request.resource.data.at == request.time
        && request.resource.data.readBy == [request.auth.uid]
        && (!(request.resource.data.get('text', '') is string) || request.resource.data.get('text', '').size() <= 4000);
      allow update: if isMember(c) && (
        // members change only their own entry in readBy / reactions / starredBy / hiddenFor
        ( request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy','reactions','starredBy','hiddenFor'])
          && ownItemOnly(request.resource.data.get('readBy', []), resource.data.get('readBy', []))
          && ownItemOnly(request.resource.data.get('starredBy', []), resource.data.get('starredBy', []))
          && ownItemOnly(request.resource.data.get('hiddenFor', []), resource.data.get('hiddenFor', []))
          && ownKeyOnly(request.resource.data.get('reactions', {}), resource.data.get('reactions', {})) )
        // the sender edits or deletes own message
        || ( resource.data.from == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','edited','deleted','img','audio','file']) )
      );
    }
  }
}}
