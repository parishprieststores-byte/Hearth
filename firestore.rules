rules_version = '2';
// Hearth 2.0 P0 rules. NOT executed against the Firestore emulator (none available in the build environment).
service cloud.firestore { match /databases/{d}/documents {
  function signedIn(){ return request.auth != null; }
  function isMember(c){ return signedIn() && request.auth.uid in get(/databases/$(d)/documents/chats/$(c)).data.members; }
  // true when a per-user map changed only under the caller's own uid
  function ownKeyOnly(a, b){ return a.diff(b).affectedKeys().hasOnly([request.auth.uid]); }
  // true when a list gained or lost nothing except the caller's uid
  function ownItemOnly(a, b){ return a.toSet().difference(b.toSet()).hasOnly([request.auth.uid]) && b.toSet().difference(a.toSet()).hasOnly([request.auth.uid]); }

  match /users/{u} {
    allow read: if signedIn();
    allow create, update: if request.auth.uid == u
      && request.resource.data.keys().hasOnly(['name','nameLower','email','photo','about','bmd','updates','updAt','lastSeen'])
      && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 160
      && (!('about' in request.resource.data) || (request.resource.data.about is string && request.resource.data.about.size() <= 300))
      && (!('updates' in request.resource.data) || (request.resource.data.updates is list && request.resource.data.updates.size() <= 6));
    allow delete: if request.auth.uid == u;
  }

  // voice-call signalling (only people who already share a chat can ring each other)
  match /calls/{id} {
    allow read: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    allow create: if signedIn() && request.resource.data.from == request.auth.uid && request.resource.data.to != request.auth.uid
      && request.resource.data.keys().hasOnly(['from','to','chat','state','offer','at'])
      && request.resource.data.state == 'ringing' && request.resource.data.at == request.time
      && request.resource.data.offer.sdp.size() <= 20000
      && request.auth.uid in get(/databases/$(d)/documents/chats/$(request.resource.data.chat)).data.members
      && request.resource.data.to in get(/databases/$(d)/documents/chats/$(request.resource.data.chat)).data.members;
    allow update: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid)
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state','answer','endedAt'])
      && request.resource.data.state in ['ringing','active','ended','declined','missed'];
    match /ice/{i} {
      allow read: if signedIn() && (get(/databases/$(d)/documents/calls/$(id)).data.to == request.auth.uid || get(/databases/$(d)/documents/calls/$(id)).data.from == request.auth.uid);
      allow create: if signedIn() && request.resource.data.from == request.auth.uid && request.resource.data.keys().hasOnly(['from','c']) && request.resource.data.c.size() <= 2000
        && (get(/databases/$(d)/documents/calls/$(id)).data.to == request.auth.uid || get(/databases/$(d)/documents/calls/$(id)).data.from == request.auth.uid);
    }
  }

  match /chats/{c} {
    allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.members);

    allow create: if signedIn() && request.auth.uid in request.resource.data.members
      && request.resource.data.members.size() <= 256
      && (
        // saved messages
        (request.resource.data.members.size() == 1 && c == request.auth.uid + '_self')
        // direct chat: id is the two sorted uids
        || (request.resource.data.members.size() == 2 && request.resource.data.isGroup == false
            && c == request.resource.data.members[0] + '_' + request.resource.data.members[1])
        // group: the creator becomes the only admin
        || (request.resource.data.members.size() >= 3 && request.resource.data.isGroup == true
            && request.resource.data.admins == [request.auth.uid])
      );

    allow update: if signedIn() && request.auth.uid in resource.data.members && (
      // 1. ordinary member activity: members and admins cannot change, per-user maps only under own uid
      ( request.resource.data.members == resource.data.members
        && request.resource.data.get('admins', []) == resource.data.get('admins', [])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastFrom','lastText','lastAt','unread','typing','delivered','arch','folder','mute','pin','names','pinned','title','photo'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['title','photo'])
            || resource.data.isGroup == true && request.auth.uid in resource.data.get('admins', resource.data.members))
        && (!('lastFrom' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.lastFrom == request.auth.uid)
        && ownKeyOnly(request.resource.data.get('typing', {}), resource.data.get('typing', {}))
        && ownKeyOnly(request.resource.data.get('delivered', {}), resource.data.get('delivered', {}))
        && ownKeyOnly(request.resource.data.get('arch', {}), resource.data.get('arch', {}))
        && ownKeyOnly(request.resource.data.get('folder', {}), resource.data.get('folder', {}))
        && ownKeyOnly(request.resource.data.get('mute', {}), resource.data.get('mute', {}))
        && ownKeyOnly(request.resource.data.get('pin', {}), resource.data.get('pin', {}))
        && ownKeyOnly(request.resource.data.get('names', {}), resource.data.get('names', {}))
      )
      // 2. group admins manage membership (legacy groups without an admins list: every member is an admin)
      || ( resource.data.isGroup == true
        && request.auth.uid in resource.data.get('admins', resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','admins','names','unread','typing','delivered'])
        && request.resource.data.members.size() >= 2 && request.resource.data.members.size() <= 256
        && request.resource.data.get('admins', []).toSet().difference(request.resource.data.members.toSet()).size() == 0
        && request.auth.uid in request.resource.data.members )
      // 3. any member may leave a group (removing only themselves)
      || ( resource.data.isGroup == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','admins'])
        && ownItemOnly(request.resource.data.members, resource.data.members)
        && !(request.auth.uid in request.resource.data.members)
        && request.resource.data.get('admins', []).toSet().difference(request.resource.data.members.toSet()).size() == 0 )
    );

    // file chunks (base64 pieces of documents; free plan has no Storage)
    match /chunks/{k} {
      allow read: if isMember(c);
      allow create: if isMember(c) && request.resource.data.from == request.auth.uid
        && request.resource.data.keys().hasOnly(['fid','n','d','from','at'])
        && request.resource.data.n is int && request.resource.data.n >= 0 && request.resource.data.n < 10
        && k == request.resource.data.fid + '_' + string(request.resource.data.n)
        && request.resource.data.d is string && request.resource.data.d.size() <= 720000
        && request.resource.data.at == request.time;
      allow delete: if isMember(c) && resource.data.from == request.auth.uid;
    }

    match /messages/{m} {
      allow read: if isMember(c);
      allow create: if isMember(c) && request.resource.data.from == request.auth.uid
        && request.resource.data.keys().hasOnly(['from','text','img','audio','reply','fwd','at','readBy','file','st','gif','call'])
        && (!('st' in request.resource.data) || request.resource.data.st is bool)
        && (!('gif' in request.resource.data) || (request.resource.data.gif is string && request.resource.data.gif.size() <= 300 && request.resource.data.gif.matches('https://media[0-9]*\\.giphy\\.com/.*')))
        && (!('call' in request.resource.data) || (request.resource.data.call is map && request.resource.data.call.keys().hasOnly(['r','d'])
            && request.resource.data.call['r'] in ['ended','missed','cancelled','declined'] && request.resource.data.call['d'] is int
            && request.resource.data.call['d'] >= 0 && request.resource.data.call['d'] <= 86400))
        && (!('file' in request.resource.data) || (request.resource.data.file is map && request.resource.data.file.keys().hasOnly(['id','name','size','type','n'])
            && request.resource.data.file['n'] is int && request.resource.data.file['n'] >= 1 && request.resource.data.file['n'] <= 10
            && request.resource.data.file['size'] is int && request.resource.data.file['size'] <= 5000000
            && request.resource.data.file['name'] is string && request.resource.data.file['name'].size() <= 120))
        && request.resource.data.at == request.time
        && request.resource.data.readBy == [request.auth.uid]
        && (!(request.resource.data.get('text', '') is string) || request.resource.data.get('text', '').size() <= 4000);
      allow update: if isMember(c) && (
        // members change only their own entry in readBy / reactions / starredBy / hiddenFor
        ( request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy','reactions','starredBy','hiddenFor'])
          && ownItemOnly(request.resource.data.get('readBy', []), resource.data.get('readBy', []))
          && ownItemOnly(request.resource.data.get('starredBy', []), resource.data.get('starredBy', []))
          && ownItemOnly(request.resource.data.get('hiddenFor', []), resource.data.get('hiddenFor', []))
          && ownKeyOnly(request.resource.data.get('reactions', {}), resource.data.get('reactions', {})) )
        // the sender edits or deletes own message
        || ( resource.data.from == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','edited','deleted','img','audio','file']) )
      );
    }
  }
}}
