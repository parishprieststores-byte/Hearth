rules_version = '2';
service cloud.firestore { match /databases/{d}/documents {
  function signedIn(){ return request.auth != null; }
  function isMember(c){ return signedIn() && request.auth.uid in get(/databases/$(d)/documents/chats/$(c)).data.members; }
  function ownKeyOnly(a, b){ return a.diff(b).affectedKeys().hasOnly([request.auth.uid]); }
  function ownItemOnly(a, b){ return a.toSet().difference(b.toSet()).hasOnly([request.auth.uid]) && b.toSet().difference(a.toSet()).hasOnly([request.auth.uid]); }

  match /users/{u} {
    allow read: if signedIn();
    allow create, update: if request.auth.uid == u
      && request.resource.data.keys().hasOnly(['name','nameLower','email','photo','about','bmd','updates','updAt','lastSeen'])
      && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 160
      && (!('about' in request.resource.data) || (request.resource.data.about is string && request.resource.data.about.size() <= 300))
      && (!('updates' in request.resource.data) || (request.resource.data.updates is list && request.resource.data.updates.size() <= 6));
    allow delete: if request.auth.uid == u;
  }

  match /chats/{c} {
    allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.members);

    allow create: if signedIn() && request.auth.uid in request.resource.data.members
      && request.resource.data.members.size() <= 256
      && (
        (request.resource.data.members.size() == 1 && c == request.auth.uid + '_self')
        || (request.resource.data.members.size() == 2 && request.resource.data.isGroup == false
            && c == request.resource.data.members[0] + '_' + request.resource.data.members[1])
        || (request.resource.data.members.size() >= 3 && request.resource.data.isGroup == true
            && request.resource.data.admins == [request.auth.uid])
      );

    allow update: if signedIn() && request.auth.uid in resource.data.members && (
      ( request.resource.data.members == resource.data.members
        && request.resource.data.get('admins', []) == resource.data.get('admins', [])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastFrom','lastText','lastAt','unread','typing','delivered','arch','folder','mute','pin','names','pinned','title','photo'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['title','photo'])
            || resource.data.isGroup == true && request.auth.uid in resource.data.get('admins', resource.data.members))
        && (!('lastFrom' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.lastFrom == request.auth.uid)
        && ownKeyOnly(request.resource.data.get('typing', {}), resource.data.get('typing', {}))
        && ownKeyOnly(request.resource.data.get('delivered', {}), resource.data.get('delivered', {}))
        && ownKeyOnly(request.resource.data.get('arch', {}), resource.data.get('arch', {}))
        && ownKeyOnly(request.resource.data.get('folder', {}), resource.data.get('folder', {}))
        && ownKeyOnly(request.resource.data.get('mute', {}), resource.data.get('mute', {}))
        && ownKeyOnly(request.resource.data.get('pin', {}), resource.data.get('pin', {}))
        && ownKeyOnly(request.resource.data.get('names', {}), resource.data.get('names', {}))
      )
      || ( resource.data.isGroup == true
        && request.auth.uid in resource.data.get('admins', resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','admins','names','unread','typing','delivered'])
        && request.resource.data.members.size() >= 2 && request.resource.data.members.size() <= 256
        && request.resource.data.get('admins', []).toSet().difference(request.resource.data.members.toSet()).size() == 0
        && request.auth.uid in request.resource.data.members )
      || ( resource.data.isGroup == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','admins'])
        && ownItemOnly(request.resource.data.members, resource.data.members)
        && !(request.auth.uid in request.resource.data.members)
        && request.resource.data.get('admins', []).toSet().difference(request.resource.data.members.toSet()).size() == 0 )
    );

    match /messages/{m} {
      allow read: if isMember(c);
      allow create: if isMember(c) && request.resource.data.from == request.auth.uid
        && request.resource.data.keys().hasOnly(['from','text','img','audio','reply','fwd','at','readBy'])
        && request.resource.data.at == request.time
        && request.resource.data.readBy == [request.auth.uid]
        && (!(request.resource.data.get('text', '') is string) || request.resource.data.get('text', '').size() <= 4000);
      allow update: if isMember(c) && (
        ( request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy','reactions','starredBy','hiddenFor'])
          && ownItemOnly(request.resource.data.get('readBy', []), resource.data.get('readBy', []))
          && ownItemOnly(request.resource.data.get('starredBy', []), resource.data.get('starredBy', []))
          && ownItemOnly(request.resource.data.get('hiddenFor', []), resource.data.get('hiddenFor', []))
          && ownKeyOnly(request.resource.data.get('reactions', {}), resource.data.get('reactions', {})) )
        || ( resource.data.from == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','edited','deleted','img','audio']) )
      );
    }
  }
}}
